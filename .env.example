# --- PostgreSQL ---
POSTGRES_USER=amfoods_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=am_foods_db
POSTGRES_HOST_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Backend (FastAPI) ---
BACKEND_HOST_PORT=8000
TZ=Asia/Kolkata
# Add any app secrets, JWT/API keys, or CORS origins below as needed:
# SECRET_KEY=replace_with_random_hex_secret

# --- Frontend (Next.js) ---
FRONTEND_HOST_PORT=3001
NEXT_PUBLIC_API_URL=/api

# --- Nginx Gateway ---
HTTP_PORT=80